{
  "name": "pixel-mirror",
  "version": "2.0.0",
  "description": "Pixel Mirror helps developers achieve pixel-perfect UIs by easily overlaying design mockups.",
  "license": "Apache-2.0",
  "author": "Peiwen Lu",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && stylelint --fix './src/**/*.svelte'",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "exports": {
    ".": "./dist/index.js",
    "./vite": {
      "types": "./plugins/vite.d.ts",
      "default": "./plugins/vite.js"
    },
    "./astro": {
      "types": "./plugins/astro.d.ts",
      "default": "./plugins/astro.js"
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@poppanator/sveltekit-svg": "^6.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^25.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "cssnano": "^7.1.2",
    "cssnano-preset-advanced": "^7.0.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.3.0",
    "happy-dom": "^20.5.0",
    "husky": "^9.1.7",
    "idb": "^8.0.3",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "sass": "^1.97.3",
    "stylelint": "^17.1.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.6.0",
    "stylelint-prettier": "^5.0.3",
    "svelte": "^5.49.1",
    "svelte-check": "^4.3.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  },
  "files": [
    "dist",
    "plugins"
  ],
  "keywords": [
    "vite",
    "design",
    "pixel-perfect",
    "ui-overlay",
    "mockup",
    "frontend-tool",
    "svelte",
    "developer-tools"
  ],
  "homepage": "https://github.com/p233-studio/pixel-mirror#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p233-studio/pixel-mirror.git"
  },
  "bugs": {
    "url": "https://github.com/p233-studio/pixel-mirror/issues"
  }
}
